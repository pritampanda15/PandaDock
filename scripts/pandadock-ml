#!/usr/bin/env python3
"""
PandaDock-ML CLI Entry Point

Machine learning enhanced molecular docking command-line interface.
"""

import sys
import os

# Add the parent directory to the Python path
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

# Set PYTHONPATH for importing pandadock modules
os.environ['PYTHONPATH'] = os.pathsep.join([
    os.path.join(os.path.dirname(__file__), '..'),
    os.environ.get('PYTHONPATH', '')
])

if __name__ == '__main__':
    try:
        from pandadock.ml_docking_cli import main
        main()
    except ImportError as e:
        print(f"Error: Failed to import PandaDock-ML modules: {e}")
        print("Please ensure PandaDock is properly installed.")
        sys.exit(1)
    except Exception as e:
        print(f"Error: {e}")
        sys.exit(1)